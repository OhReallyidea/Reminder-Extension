{
  "manifest_version": 3,

  "name": "Sales Follow-Up Reminder",

  "version": "3.0",

  "description": "Manage merchant follow-ups and never miss a sales deadline.",

  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Sales Follow-Up Reminder"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "128": "icon128.png"
  }
}
